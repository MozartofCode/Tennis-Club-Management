# Copy to .env. Everything is optional for local development.

# SQLite by default. For production, use your Supabase Postgres connection string:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=

# Optional: Claude writes personalised retention/upsell offers. Without it, templates are used.
ANTHROPIC_API_KEY=

# Optional: send waitlist offers and member offers by email. Without it, emails are logged.
RESEND_API_KEY=
EMAIL_FROM=CourtIQ <noreply@yourclub.com>

CORS_ORIGINS=["http://localhost:5173"]
